# aibiblegospels.com environment variables
# Copy to .env.local for local dev. Set the same in Vercel for production.

# ── TikTok OAuth (for /connect/tiktok) ────────────────────────────────
TIKTOK_CLIENT_KEY=

# ── Resend (for /api/subscribe — Deut 28 cheatsheet capture) ──────────
# API key from https://resend.com/api-keys
# Needs Audiences:write + Sending:send scopes (i.e. Full access).
RESEND_API_KEY=

# Audience ID from https://resend.com/audiences
# Create an audience named "AI Bible Gospels Subscribers" and paste the UUID here.
RESEND_AUDIENCE_ID=

# ── BMB CRM lead ingestion (for /api/subscribe → LeadStack) ───────────
# Optional. When BOTH are set, every signup is also mirrored into the BMB
# CRM as a contact. If unset, the subscribe form works exactly as before
# (the CRM push silently no-ops). See bmbaiautomations/docs/sales for the
# follow-up framework that consumes these leads.
BMB_CRM_INGEST_URL=https://bmb-crm.vercel.app
# LeadStack API key (live mode), format: lsk_live_<id>:<secret>
BMB_CRM_API_KEY=

# ── Ad tracking (components/Tracking.tsx) ─────────────────────────────
# All three are OPTIONAL and all three are PUBLIC (NEXT_PUBLIC_* is inlined
# into the browser bundle at build time — never put a secret here). Each
# pixel renders nothing until its id is set, so the site ships tracking-ready
# and dark. NOTE: because they are baked at build time, setting one in Vercel
# does nothing until you REDEPLOY.
#
# One pixel per BRAND, not per lead magnet — deut28 and study-guide separate
# inside a single pixel via the event's content_name. Rationale in
# ecosystem/TRACKING.md Part 1.

# GA4 measurement id, looks like G-XXXXXXXXXX
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Meta (Facebook/Instagram) pixel id, a 15-16 digit number
NEXT_PUBLIC_META_PIXEL_ID=

# TikTok pixel id, ~20 alphanumeric chars. Highest priority of the three —
# TikTok is this brand's largest traffic source.
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
